# Copy to .env for local overrides. .env is git-ignored; never put a secret in this file.
# Every switch is off unless set to exactly "true". Test builds and CI pin them, so .env can't change those.

# Show draft articles in the build ("true" to show; never in production).
PUBLIC_SHOW_DRAFTS=
# Let search engines index the site ("true" to allow; plan 3 turns this on at launch).
PUBLIC_ALLOW_INDEXING=
# Cloudflare Web Analytics site token (public, not a secret); blank means no beacon.
PUBLIC_CF_WEB_ANALYTICS_TOKEN=
# Folder to read articles from instead of src/content/articles (tests use fixtures).
PD_CONTENT_DIR=
# Folder to build into instead of dist.
PD_OUT_DIR=
