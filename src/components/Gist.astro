---
// "The gist": the summary box at the top of every article (spec: article structure).
interface Props {
  text: string;
}
const { text } = Astro.props;
---

<section class="gist" data-gist aria-labelledby="gist-label">
  <h2 class="label gist__label" id="gist-label">The gist</h2>
  <p class="gist__text">{text}</p>
</section>

<style>
  .gist {
    padding: var(--space-5) var(--space-5) var(--space-5) calc(var(--space-5) - 4px);
    background: var(--paper);
    border-left: 4px solid var(--signal);
    border-radius: 0 var(--radius-2) var(--radius-2) 0;
  }

  .gist__label {
    color: var(--muted);
  }

  .gist__text {
    margin-top: var(--space-2);
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    color: var(--ink);
  }
</style>
