---
// The two ways into the guides: by technology (topics) and by problem.
import BaseLayout from '../../layouts/BaseLayout.astro';
import TermGrid from '../../components/TermGrid.astro';
import { TOPICS, PROBLEMS } from '../../data/taxonomy';

const sections = [
  { id: 'by-technology', heading: 'By technology', list: 'topics', base: '/topics/', terms: TOPICS },
  { id: 'by-problem', heading: 'By problem', list: 'problems', base: '/problems/', terms: PROBLEMS },
];
---

<BaseLayout
  title="Topics"
  description="Browse the guides by technology or by the business problem they address."
  path="/topics/"
>
  <div class="wrap topics">
    <header class="topics__head">
      <p class="label">Browse</p>
      <h1>Topics</h1>
      <p class="topics__lede">
        Find guides by the technology involved or by the problem you want to fix.
      </p>
    </header>

    {
      sections.map((s) => (
        <section class="topics__section" aria-labelledby={s.id}>
          <h2 class="topics__heading" id={s.id}>
            {s.heading}
          </h2>
          <TermGrid terms={s.terms} base={s.base} list={s.list} />
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .topics {
    display: grid;
    gap: var(--space-8);
    padding-block: var(--space-8) var(--space-9);
  }

  .topics__head h1 {
    margin-top: var(--space-4);
  }

  .topics__lede {
    margin-top: var(--space-5);
    max-width: var(--measure);
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    color: var(--ink-soft);
  }

  .topics__heading {
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-3);
    border-bottom: 2px solid var(--ink);
    font-size: var(--step-2);
  }
</style>
