---
// Homepage: what the site is, then two ways in (by problem, by technology),
// then the latest articles.
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import EmptyState from '../components/EmptyState.astro';
import TermGrid from '../components/TermGrid.astro';
import { PROBLEMS, TOPICS } from '../data/taxonomy';
import { getPublishedArticles } from '../lib/articles';

const latest = (await getPublishedArticles()).slice(0, 3);
---

<BaseLayout
  description="Plain-English guides to data, AI, digital twins, IoT and cloud for UK industrial leaders."
  path="/"
>
  <section class="wrap hero" data-home-section="hero">
    <p class="label">Data · AI · Digital twins · IoT · Cloud</p>
    <h1>Digital technology, explained for the people who run industries</h1>
    <p class="hero__lede">
      Practical technology guides for leaders and managers. Each one covers what a technology is, which problems it solves, what it costs and
      when it isn't worth doing.
    </p>
    <p class="hero__stance">
      The guides start from data: each one says plainly that the technology fails on data you can't
      trust.
    </p>
  </section>

  <section class="wrap home-section" data-home-section="problems" aria-labelledby="problems-heading">
    <div class="home-section__head">
      <h2 id="problems-heading">Start with a problem</h2>
      <p>Pick the problem closest to yours and see which guides deal with it.</p>
    </div>
    <TermGrid terms={PROBLEMS} base="/problems/" list="problems" />
  </section>

  <section class="wrap home-section" data-home-section="topics" aria-labelledby="topics-heading">
    <div class="home-section__head">
      <h2 id="topics-heading">Explore a technology</h2>
      <p>Already have a technology in mind? Start there.</p>
    </div>
    <TermGrid terms={TOPICS} base="/topics/" list="topics" />
  </section>

  <section class="wrap home-section" data-home-section="latest" aria-labelledby="latest-heading">
    <div class="home-section__head home-section__head--row">
      <h2 id="latest-heading">Latest insights</h2>
      {latest.length > 0 && <a class="home-section__all" href="/insights/">All insights</a>}
    </div>
    {
      latest.length > 0 ? (
        <ul class="latest__cards">
          {latest.map((article) => (
            <li>
              <ArticleCard article={article} level={3} />
            </li>
          ))}
        </ul>
      ) : (
        <EmptyState
          level={3}
          heading="No guides published yet"
          body="The first ones are being written. The topics page shows what they'll cover."
          linkHref="/topics/"
          linkText="See the topics"
        />
      )
    }
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-8) var(--space-7);
  }

  .hero h1 {
    margin-top: var(--space-4);
    max-width: 20ch;
  }

  .hero__lede {
    margin-top: var(--space-5);
    max-width: var(--measure);
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    color: var(--ink-soft);
  }

  .hero__stance {
    margin-top: var(--space-4);
    max-width: var(--measure);
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    font-weight: 500;
  }

  .home-section {
    padding-block: var(--space-6) var(--space-7);
  }

  .home-section:last-child {
    padding-bottom: var(--space-9);
  }

  .home-section__head {
    display: grid;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-3);
    border-bottom: 2px solid var(--ink);
  }

  .home-section__head h2 {
    font-size: var(--step-2);
  }

  .home-section__head p {
    color: var(--ink-soft);
  }

  .home-section__head--row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .home-section__all {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-weight: 500;
  }

  .latest__cards {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: var(--rule);
  }

  /* The section heading's rule already separates the first card. */
  .latest__cards > li:first-child :global(.card) {
    border-top: 0;
  }
</style>
