---
// The shell every page uses: head tags, skip link, header, main and footer.
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-400-italic.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '../styles/tokens.css';
import '../styles/global.css';

import SeoHead from '../components/SeoHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CloudflareAnalytics from '../components/CloudflareAnalytics.astro';
import { analyticsToken } from '../lib/env';
import { SITE_NAME, SITE_URL, type MetaInput } from '../lib/seo';

type Props = MetaInput;

const cfToken = analyticsToken();
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1b1f23" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href={`${SITE_URL}/rss.xml`} />
    <SeoHead {...Astro.props} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    {cfToken && <CloudflareAnalytics token={cfToken} />}
  </body>
</html>

<style>
  /* The skip link moves focus to main; main itself needs no visible ring. */
  main:focus {
    outline: none;
    box-shadow: none;
  }
</style>
